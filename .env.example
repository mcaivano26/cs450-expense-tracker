DATABASE_URL="postgresql://appuser:appsecret@localhost:5434/expense_tracker_app?schema=public"
PORT=4002

# Used by docker-compose.yml for the db service
POSTGRES_USER=appuser
POSTGRES_PASSWORD=appsecret
POSTGRES_DB=expense_tracker_app

# Used by docker-compose.yml for the api service: signing key for login tokens (JWTs)
JWT_SECRET=replace-with-a-long-random-string
