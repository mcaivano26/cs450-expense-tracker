// Starter schema for expense tracker app
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String        @id @default(cuid())
  name      String
  email     String        @unique
  // bcrypt hash of the user's password. Never the password itself, and never sent in an API response.
  // Nullable because the demo user (src/demoUser.ts) has no login.
  passwordHash String?
  transactions Transaction[]
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  title       String
  amount      Float
  category    String
  date        DateTime
  type        String   @default("expense")
  description String?
  user        User     @relation(fields: [userId], references: [id])
}
