{
    "name":"expense-tracker-backend",
    "version":"1.0.0","private":true,
    "type":"module","scripts": {
        "dev":"tsx watch src/index.ts",
        "build":"tsc",
        "start":"node dist/index.js",
        "test":"vitest run",
        "test:watch":"vitest",
        "generate:data":"tsx src/data/generateTransactions.ts",
        "seed":"tsx prisma/seed.ts",
        "lint":"eslint ."
    },
    "dependencies": {
        "@prisma/client":"^6.19.3",
        "cors":"^2.8.5",
        "dotenv":"^16.4.5",
        "express":"^4.19.2",
        "zod":"^3.25.76"
    },
    "devDependencies": {
        "@eslint/js":"^9.39.5",
        "@types/cors":"^2.8.5",
        "@types/express":"^5.0.0",
        "@types/node":"^22.10.2",
        "@types/supertest":"^7.2.1",
        "eslint":"^9.39.5",
        "globals":"^17.14.0",
        "prisma":"^6.19.3",
        "supertest":"^7.3.1",
        "tsx":"^4.19.1",
        "typescript":"^5.7.2",
        "typescript-eslint":"^8.72.2",
        "vitest":"^5.0.5"
    },
    "allowScripts": {
        "@prisma/client":true,
        "@prisma/engines":true,
        "esbuild":true,
        "prisma":true
    },
    "prisma": {
        "seed":"tsx prisma/seed.ts"
    }
}
